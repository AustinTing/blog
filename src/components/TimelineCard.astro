---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: 'work' | 'life';
  cover?: string;
  slug: string;
  milestone?: boolean;
}

const { title, description, date, category, cover, slug, milestone } = Astro.props;

const monthDay = date.toLocaleDateString('zh-TW', {
  month: '2-digit',
  day: '2-digit',
});
---

<span class="timeline-date">{monthDay}</span>
<a href={`/blog/${slug}`} class="timeline-card-inner">
  {milestone && <span class="milestone-mark">★</span>}
  <span class={`category-badge badge-${category}`}>{category}</span>
  <h2 class="card-title">{title}</h2>
  <p class="card-description">{description}</p>
  {cover && (
    <img
      src={cover}
      alt={`${title} cover`}
      class="card-cover"
      loading="lazy"
    />
  )}
</a>
